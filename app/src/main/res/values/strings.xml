    <string name="onboarding_1_title">Six protection modes</string>
    <string name="onboarding_1_text">Use Table for a phone on a surface, Pocket for a pocket, Bag for a bag, Charging for external power, Accessory for connected audio devices, and Journey for time-limited Pocket or Bag protection.</string>
    <string name="onboarding_2_title">Sensor-aware protection</string>
    <string name="onboarding_2_text">Phone Guard combines the sensors actually available on the device and will not claim a mode is supported when the detector cannot reach a reliable alarm decision.</string>
    <string name="onboarding_3_title">Only the owner can stop it</string>
    <string name="onboarding_3_text">Set a 4–6 digit PIN and optionally enable strong biometrics. Unlocking the phone alone does not authenticate Phone Guard.</string>
    <string name="onboarding_4_title">Local deterrence</string>
    <string name="onboarding_4_text">Detection runs locally. Siren, vibration, flash and the warning screen are best-effort outputs subject to Android and OEM limits.</string>

    <string name="about_title">Info and privacy</string>
    <string name="about_brand">PHONE GUARD</string>
    <string name="about_how_title">How it works</string>
    <string name="about_how_text">Table monitors calibrated motion. Pocket and Bag use available proximity, light, motion and rotation evidence. Charging monitors external power removal. Journey runs a time-limited Pocket or Bag session. Phone Guard only marks a mode available when its required evidence is present.</string>
    <string name="about_privacy_title">Data and privacy</string>
    <string name="about_privacy_text">Detection is processed on-device. Phone Guard does not record audio, use location, or capture photos or video. Event history stays in local app storage.</string>
    <string name="about_camera_title">Camera permission</string>
    <string name="about_camera_text">Camera permission is used only for Android torch/flash APIs. Phone Guard never uses the camera to capture images or video.</string>
    <string name="about_account_title">No account</string>
    <string name="about_account_text">Phone Guard requires no registration or login. Core protection works locally without a proprietary account or backend.</string>
    <string name="about_backup_title">Android backup</string>
    <string name="about_backup_text">Non-sensitive preferences may use Android backup or device transfer. PIN verifier data, active protection state, alarm-volume lease and event history are excluded.</string>
    <string name="about_fgs_title">Foreground service</string>
    <string name="about_fgs_text">When you arm protection, one visible foreground service monitors the selected sensors. The service stops when protection is disarmed. Android or the device manufacturer can still restrict background execution in exceptional cases.</string>
    <string name="about_outputs_title">Alarm output limits</string>
    <string name="about_outputs_text">Siren, vibration, flash, alarm volume and visual warning are best-effort outputs. Do Not Disturb, OEM policy, unavailable hardware, force-stop or system shutdown can limit them. The app reports effective capability instead of guaranteeing an override.</string>
    <string name="about_limits_title">Limits</string>
    <string name="about_limits_text">Phone Guard is a local deterrence and alert tool. It cannot physically prevent theft, power-off, force-stop or operating-system actions.</string>

