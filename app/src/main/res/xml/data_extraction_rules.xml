<!-- Phone Guard extraction policy: never transfer local owner/security/runtime evidence. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <include domain="file" path="datastore/phone_guard_settings.preferences_pb" />

        <exclude domain="file" path="datastore/phone_guard_security.preferences_pb" />
        <exclude domain="file" path="events.json" />
        <exclude domain="sharedpref" path="protection_runtime_session.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="datastore/phone_guard_settings.preferences_pb" />

        <exclude domain="file" path="datastore/phone_guard_security.preferences_pb" />
        <exclude domain="file" path="events.json" />
        <exclude domain="sharedpref" path="protection_runtime_session.xml" />
    </device-transfer>
</data-extraction-rules>
