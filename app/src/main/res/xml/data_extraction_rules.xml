<!-- TARGET: app/src/main/res/xml/data_extraction_rules.xml -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/security.preferences_pb" />
        <exclude domain="file" path="events.json" />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/security.preferences_pb" />
        <exclude domain="file" path="events.json" />
    </device-transfer>
</data-extraction-rules>
